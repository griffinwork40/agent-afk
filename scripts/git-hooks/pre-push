#!/bin/sh
# pre-push hook — guards direct main pushes, then runs pnpm check:audits.
# Tracked at scripts/git-hooks/pre-push; installed into .git/hooks by
# scripts/install-pre-push-hook.mjs (runs on pnpm install via prepare).
#
# Only audits fail open for missing dependencies/tools or a broken environment.
# The main guard needs only git and POSIX utilities and runs first.
# Human override for main: AFK_ALLOW_MAIN_PUSH=1 (audits still run).
# Bypass the entire hook: git push --no-verify

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$toplevel" || exit 1

refuse_main() {
  echo "pre-push: refusing direct push to main; open a PR instead. Only chore(release): or docs(changelog): commits are allowed. Human override: AFK_ALLOW_MAIN_PUSH=1 git push" >&2
  exit 1
}

# Consume stdin once for both the main guard and deletion-only audit shortcut.
# Git fields: <local-ref> <local-sha> <remote-ref> <remote-sha>.
# Strip CR for CRLF clients; read treats fields as data, never shell code.
push_stdin=$(cat | tr -d '\r')
zero=0000000000000000000000000000000000000000
all_deletions=1
found_any=0
if [ -n "$push_stdin" ]; then
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    found_any=1
    [ "$local_sha" = "$zero" ] && continue
    all_deletions=0
    if [ "$remote_ref" = refs/heads/main ] && [ "${AFK_ALLOW_MAIN_PUSH:-}" != 1 ]; then
      # New remote main: inspect the entire reachable history, not an invalid
      # zero..HEAD range. Include all parents (no --first-parent/--no-merges).
      range=$local_sha
      [ "$remote_sha" = "$zero" ] || range="$remote_sha..$local_sha"
      commits=$(git -c log.showSignature=false log --no-show-signature --format='%h %s' "$range" --) || {
        printf 'pre-push: cannot inspect main push range %s; run git fetch and retry.\n' "$range" >&2
        exit 1
      }
      if [ -n "$commits" ]; then
        while IFS=' ' read -r commit subject; do
          case "$subject" in
            'chore(release):'*|'docs(changelog):'*) ;;
            *)
              printf 'pre-push: offending commit: %s %s\n' "$commit" "$subject" >&2
              refuse_main
              ;;
          esac
        done <<COMMITS_END
$commits
COMMITS_END
      fi
    fi
  done <<PUSH_STDIN_END
$push_stdin
PUSH_STDIN_END
fi

# No refs pushed (empty stdin) or all deletions — nothing to audit.
if [ "$found_any" -eq 0 ] || [ "$all_deletions" -eq 1 ]; then
  exit 0
fi

# Fail-open: node_modules absent.
if [ ! -d node_modules ]; then
  echo "pre-push: node_modules not found — skipping audit gates (run pnpm install)" >&2
  exit 0
fi

# Fail-open: node not on PATH. The package-script probe below needs node.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found on PATH — skipping audit gates" >&2
  exit 0
fi

# Fail-open: this package/branch does not define check:audits.
if ! node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));process.exit(p.scripts&&p.scripts['check:audits']?0:1)" "$toplevel/package.json" >/dev/null 2>&1; then
  echo "pre-push: package.json lacks scripts.check:audits — skipping audit gates" >&2
  exit 0
fi

# Fail-open: pnpm not on PATH.
if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: pnpm not found on PATH — skipping audit gates" >&2
  exit 0
fi

echo "pre-push: running pnpm check:audits …" >&2

pnpm check:audits
exit_code=$?

if [ "$exit_code" -eq 2 ]; then
  echo "" >&2
  echo "pre-push: every audit gate failed — environment may be broken." >&2
  echo "  Try: pnpm install" >&2
  echo "  Then re-try your push, or bypass with: git push --no-verify" >&2
  exit 0
fi

if [ "$exit_code" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: CI will fail these checks — fix them before pushing." >&2
  echo "  Do NOT regenerate ratchet baselines just to silence a gate." >&2
  echo "  Bypass (use sparingly): git push --no-verify" >&2
  exit 1
fi

exit 0
