#!/bin/sh
# pre-push hook — runs pnpm check:audits before every push.
# Tracked at scripts/git-hooks/pre-push; installed into .git/hooks by
# scripts/install-pre-push-hook.mjs (runs on pnpm install via prepare).
#
# Fail-open: if the environment looks broken (node_modules missing, node/pnpm
# unavailable, or this checkout lacks a check:audits script) this hook exits 0
# so developers are never hard-blocked.
#
# Bypass: git push --no-verify

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

cd "$toplevel"

# Fail-open: node_modules absent.
if [ ! -d node_modules ]; then
  echo "pre-push: node_modules not found — skipping audit gates (run pnpm install)" >&2
  exit 0
fi

# Fail-open: node not on PATH. The package-script probe below needs node.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found on PATH — skipping audit gates" >&2
  exit 0
fi

# Fail-open: this package/branch does not define check:audits.
if ! node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));process.exit(p.scripts&&p.scripts['check:audits']?0:1)" "$toplevel/package.json" >/dev/null 2>&1; then
  echo "pre-push: package.json lacks scripts.check:audits — skipping audit gates" >&2
  exit 0
fi

# Fail-open: pnpm not on PATH.
if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: pnpm not found on PATH — skipping audit gates" >&2
  exit 0
fi

# If every pushed ref is a deletion (local sha is all zeros), skip.
# Git pre-push stdin fields are: <local-ref> <local-sha> <remote-ref> <remote-sha>.
# Strip \r before the read loop so the deletion-skip check works on CRLF git
# clients under POSIX dash/ash (dash's `read -r` does not strip \r before
# field splitting). Use a temporary variable + printf to avoid the empty-stdin
# ambiguity that a plain heredoc $var expansion would introduce.
push_stdin=$(cat | tr -d '\r')
all_deletions=1
found_any=0
if [ -n "$push_stdin" ]; then
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    found_any=1
    case "$local_sha" in
      0000000000000000000000000000000000000000) ;;
      *) all_deletions=0 ;;
    esac
  # Unquoted heredoc delimiter is intentional: $push_stdin must expand here.
  # Primary safety boundary: `IFS=' ' read -r` splits on spaces only with no
  # eval, so each field is consumed as a plain string regardless of content.
  # Secondary: git refs cannot contain '$' or backticks, so no injection risk.
  done <<PUSH_STDIN_END
$push_stdin
PUSH_STDIN_END
fi

# No refs pushed (empty stdin) or all deletions — nothing to check.
if [ "$found_any" -eq 0 ] || [ "$all_deletions" -eq 1 ]; then
  exit 0
fi

echo "pre-push: running pnpm check:audits …" >&2

pnpm check:audits
exit_code=$?

if [ "$exit_code" -eq 2 ]; then
  echo "" >&2
  echo "pre-push: every audit gate failed — environment may be broken." >&2
  echo "  Try: pnpm install" >&2
  echo "  Then re-try your push, or bypass with: git push --no-verify" >&2
  exit 0
fi

if [ "$exit_code" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: CI will fail these checks — fix them before pushing." >&2
  echo "  Do NOT regenerate ratchet baselines just to silence a gate." >&2
  echo "  Bypass (use sparingly): git push --no-verify" >&2
  exit 1
fi

exit 0
