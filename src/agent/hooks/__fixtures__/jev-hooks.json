{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types ${CLAUDE_PLUGIN_ROOT}/src/prompt-router.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types ${CLAUDE_PLUGIN_ROOT}/src/subagent-router.ts",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types ${CLAUDE_PLUGIN_ROOT}/src/rules.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types ${CLAUDE_PLUGIN_ROOT}/src/rules.ts",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types ${CLAUDE_PLUGIN_ROOT}/src/rules.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types ${CLAUDE_PLUGIN_ROOT}/src/rules.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types ${CLAUDE_PLUGIN_ROOT}/src/rules.ts",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.ts"
  ]
}
